# 丰源工作台 - 环境变量模板
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env

# ===== Flask =====
# Session 加密密钥。生产环境**必须**改成强随机值：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-hex-string

# ===== Moonshot Kimi Vision API =====
# 出货单 AI 图片识别使用。申请地址：https://platform.moonshot.cn/
# 格式：sk-xxxxxxxxxxxxxxxx
MOONSHOT_API_KEY=sk-your-moonshot-api-key

# ===== DeepSeek API =====
# 语音切句 + OCR 比对使用。申请地址：https://platform.deepseek.com/
# 格式：sk-xxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# 可选：自定义 base_url（用代理或兼容服务时）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：自定义模型名（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# ===== 百度短语音识别 API（语音录入功能）=====
# 申请地址：https://console.bce.baidu.com/
#   1. 创建应用 → 开通「短语音识别」服务
#   2. 拿到 API Key + Secret Key
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key
# 可选：自定义端点（默认官方）
# BAIDU_VOICE_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token
# BAIDU_VOICE_API_URL=https://vop.baidu.com/server_api

# ===== ffmpeg（语音转码，浏览器录音 webm → 百度 pcm/wav）=====
# Windows 示例：C:\Program Files\ffmpeg\bin\ffmpeg.exe
# Linux：/usr/bin/ffmpeg（apt install ffmpeg）
# macOS：brew install ffmpeg
# FFMPEG_PATH=C:\Program Files\ffmpeg\bin\ffmpeg.exe

# ===== 运行环境 =====
# development = 调试模式，模板自动重载
# production  = 关闭 debug，使用生产 WSGI
FLASK_ENV=development

# ===== 可选：数据库路径 =====
# 留空则使用默认 worklog.db
# DATABASE_PATH=

# ===== 可选：OCR/AI 日志级别 =====
# INFO （默认）只记调用摘要：引擎/图片/耗时/结果
# DEBUG        额外记完整 prompt 与 LLM 原始返回，排查判定错误时打开
# 注意：调用失败时无论哪个级别都会记全量 prompt + 堆栈
# OCR_LOG_LEVEL=INFO
